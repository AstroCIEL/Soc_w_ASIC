  type (sram128x128_q) {
    base_type : array ;
    data_type : bit ;
    bit_width : 128;
    bit_from : 127;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x128_a) {
    base_type : array ;
    data_type : bit ;
    bit_width : 7;
    bit_from : 6;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x128_d) {
    base_type : array ;
    data_type : bit ;
    bit_width : 128;
    bit_from : 127;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x128_ema) {
    base_type : array ;
    data_type : bit ;
    bit_width : 3;
    bit_from : 2;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x128_emaw) {
    base_type : array ;
    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x128_wablm) {
    base_type : array ;
    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x128_rawlm) {
    base_type : array ;
    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }

  /* voltage-maps */
  voltage_map (VDDPE, 0.8);
  voltage_map (VDDCE, 0.8);
  voltage_map (VSSE, 0.0);

  /* operating-conditions */
  operating_conditions(tt_typical_0p80v_0p80v_25c) {
    process      : 1;
    temperature  : 25;
    voltage      : 0.8;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : tt_typical_0p80v_0p80v_25c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(sram128x128) {
    area : 7911.360000;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    is_macro_cell : true;
    /* Peak current of all modes. */
    peak_current : 59.757885;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 28.487110;
    /* leakage current in retention mode (ret1n=0) */
    retention_current : 0.0007517;
    memory() {
      type : ram;
      address_width : 7;
      word_width : 128;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    bus(q) {
      bus_type : sram128x128_q;
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      memory_read() {
        address : a;
      }
      max_capacitance : 0.280000;
      max_transition : 1.042800;
      timing() {
        related_pin : clk;
        timing_type : rising_edge;
        timing_sense : non_unate;
        when : "ret1n&!cen&wen&!ema[2]&!ema[1]&!ema[0]";
        sdf_cond : "ret1n == 1'b1 && cen == 1'b0 && wen == 1'b1 && ema[2] == 1'b0 && \
                ema[1] == 1'b0 && ema[0] == 1'b0";
        cell_rise(sram128x128_clockslew_outputload_delay_template) {
          index_1 ("0.001000, 0.007000, 0.025000, 0.061000, 0.115000, 0.195000, 0.292000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
            "0.296309, 0.299682, 0.305299, 0.314157, 0.328440, 0.356053, 0.410068", \
            "0.297119, 0.300492, 0.306109, 0.314967, 0.329250, 0.356863, 0.410877", \
            "0.301977, 0.305351, 0.310967, 0.319825, 0.334108, 0.361721, 0.415736", \
            "0.310078, 0.313451, 0.319068, 0.327926, 0.342209, 0.369822, 0.423837", \
            "0.322915, 0.326289, 0.331905, 0.340763, 0.355046, 0.382660, 0.436674", \
            "0.337523, 0.340897, 0.346513, 0.355371, 0.369654, 0.397267, 0.451282", \
            "0.350048, 0.353421, 0.359038, 0.367896, 0.382179, 0.409792, 0.463806" \
          );
        }
        retaining_rise(sram128x128_clockslew_outputload_retain_template) {
          index_1 ("0.001000, 0.007000, 0.025000, 0.061000, 0.115000, 0.195000, 0.292000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
