  type (sram128x128_q) {
    base_type : array ;
    data_type : bit ;
    bit_width : 128;
    bit_from : 127;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x128_a) {
    base_type : array ;
    data_type : bit ;
    bit_width : 7;
    bit_from : 6;
    bit_to : 0 ;
