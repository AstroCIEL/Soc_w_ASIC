  /* voltage-maps */
  voltage_map (VDDPE, 0.72);
  voltage_map (VDDCE, 0.72);
  voltage_map (VSSE, 0.0);

  /* operating-conditions */
  operating_conditions(ssg_cworstt_0p72v_0p72v_125c) {
    process      : 1;
    temperature  : 125;
    voltage      : 0.72;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : ssg_cworstt_0p72v_0p72v_125c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(sram128x128) {
    area : 7911.360000;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    is_macro_cell : true;
    /* Peak current of all modes. */
    peak_current : 40.768761;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 19.442906;
    /* leakage current in retention mode (ret1n=0) */
    retention_current : 0.013258;
    memory() {
      type : ram;
      address_width : 7;
      word_width : 128;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    bus(q) {
      bus_type : sram128x128_q;
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      memory_read() {
        address : a;
      }
      max_capacitance : 0.280000;
      max_transition : 1.419600;
      timing() {
        related_pin : clk;
        timing_type : rising_edge;
        timing_sense : non_unate;
        when : "ret1n&!cen&wen&!ema[2]&!ema[1]&!ema[0]";
        sdf_cond : "ret1n == 1'b1 && cen == 1'b0 && wen == 1'b1 && ema[2] == 1'b0 && \
                ema[1] == 1'b0 && ema[0] == 1'b0";
        cell_rise(sram128x128_clockslew_outputload_delay_template) {
          index_1 ("0.002000, 0.009000, 0.034000, 0.082000, 0.155000, 0.264000, 0.396000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
            "0.378704, 0.386385, 0.392308, 0.405451, 0.424487, 0.460037, 0.531016", \
            "0.382112, 0.389792, 0.395715, 0.408859, 0.427894, 0.463445, 0.534423", \
            "0.388346, 0.396027, 0.401949, 0.415093, 0.434129, 0.469679, 0.540658", \
            "0.398983, 0.406664, 0.412586, 0.425730, 0.444766, 0.480316, 0.551294", \
            "0.415950, 0.423630, 0.429553, 0.442697, 0.461732, 0.497282, 0.568261", \
            "0.434348, 0.442029, 0.447951, 0.461095, 0.480130, 0.515681, 0.586659", \
            "0.451972, 0.459653, 0.465575, 0.478719, 0.497755, 0.533305, 0.604283" \
          );
        }
        retaining_rise(sram128x128_clockslew_outputload_retain_template) {
          index_1 ("0.002000, 0.009000, 0.034000, 0.082000, 0.155000, 0.264000, 0.396000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
