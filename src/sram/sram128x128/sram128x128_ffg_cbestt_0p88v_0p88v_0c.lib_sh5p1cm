  /* voltage-maps */
  voltage_map (VDDPE, 0.88);
  voltage_map (VDDCE, 0.88);
  voltage_map (VSSE, 0.0);

  /* operating-conditions */
  operating_conditions(ffg_cbestt_0p88v_0p88v_0c) {
    process      : 1;
    temperature  : 0;
    voltage      : 0.88;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : ffg_cbestt_0p88v_0p88v_0c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(sram128x128) {
    area : 7911.360000;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    is_macro_cell : true;
    /* Peak current of all modes. */
    peak_current : 84.690417;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 40.271600;
    /* leakage current in retention mode (ret1n=0) */
    retention_current : 0.0009418;
    memory() {
      type : ram;
      address_width : 7;
      word_width : 128;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    bus(q) {
      bus_type : sram128x128_q;
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      memory_read() {
        address : a;
      }
      max_capacitance : 0.280000;
      max_transition : 0.758400;
      timing() {
        related_pin : clk;
        timing_type : rising_edge;
        timing_sense : non_unate;
        when : "ret1n&!cen&wen&!ema[2]&!ema[1]&!ema[0]";
        sdf_cond : "ret1n == 1'b1 && cen == 1'b0 && wen == 1'b1 && ema[2] == 1'b0 && \
                ema[1] == 1'b0 && ema[0] == 1'b0";
        cell_rise(sram128x128_clockslew_outputload_delay_template) {
          index_1 ("0.001000, 0.005000, 0.018000, 0.044000, 0.083000, 0.141000, 0.212000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
            "0.231887, 0.234726, 0.238805, 0.245063, 0.256327, 0.277700, 0.319675", \
            "0.232209, 0.235047, 0.239126, 0.245384, 0.256648, 0.278021, 0.319996", \
            "0.235100, 0.237938, 0.242017, 0.248276, 0.259540, 0.280912, 0.322888", \
            "0.240168, 0.243007, 0.247086, 0.253344, 0.264608, 0.285981, 0.327956", \
            "0.247505, 0.250344, 0.254423, 0.260681, 0.271945, 0.293318, 0.335293", \
            "0.255777, 0.258616, 0.262694, 0.268953, 0.280217, 0.301589, 0.343565", \
            "0.263240, 0.266079, 0.270158, 0.276416, 0.287680, 0.309053, 0.351028" \
          );
        }
        retaining_rise(sram128x128_clockslew_outputload_retain_template) {
          index_1 ("0.001000, 0.005000, 0.018000, 0.044000, 0.083000, 0.141000, 0.212000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
