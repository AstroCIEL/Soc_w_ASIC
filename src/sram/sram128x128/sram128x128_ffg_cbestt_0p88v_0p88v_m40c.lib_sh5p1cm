  type (sram128x128_q) {
    base_type : array ;
    data_type : bit ;
    bit_width : 128;
    bit_from : 127;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x128_a) {
    base_type : array ;
    data_type : bit ;
    bit_width : 7;
    bit_from : 6;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x128_d) {
    base_type : array ;
    data_type : bit ;
    bit_width : 128;
    bit_from : 127;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x128_ema) {
    base_type : array ;
    data_type : bit ;
    bit_width : 3;
    bit_from : 2;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x128_emaw) {
    base_type : array ;
    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x128_wablm) {
    base_type : array ;
    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x128_rawlm) {
    base_type : array ;
    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }

  /* voltage-maps */
  voltage_map (VDDPE, 0.88);
  voltage_map (VDDCE, 0.88);
  voltage_map (VSSE, 0.0);

  /* operating-conditions */
  operating_conditions(ffg_cbestt_0p88v_0p88v_m40c) {
    process      : 1;
    temperature  : -40;
    voltage      : 0.88;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : ffg_cbestt_0p88v_0p88v_m40c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(sram128x128) {
    area : 7911.360000;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    is_macro_cell : true;
    /* Peak current of all modes. */
    peak_current : 85.846395;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 40.881356;
    /* leakage current in retention mode (ret1n=0) */
    retention_current : 0.0002859;
    memory() {
      type : ram;
      address_width : 7;
      word_width : 128;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    bus(q) {
      bus_type : sram128x128_q;
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      memory_read() {
        address : a;
      }
      max_capacitance : 0.280000;
      max_transition : 0.748800;
      timing() {
        related_pin : clk;
        timing_type : rising_edge;
        timing_sense : non_unate;
        when : "ret1n&!cen&wen&!ema[2]&!ema[1]&!ema[0]";
        sdf_cond : "ret1n == 1'b1 && cen == 1'b0 && wen == 1'b1 && ema[2] == 1'b0 && \
                ema[1] == 1'b0 && ema[0] == 1'b0";
        cell_rise(sram128x128_clockslew_outputload_delay_template) {
          index_1 ("0.001000, 0.005000, 0.018000, 0.043000, 0.082000, 0.139000, 0.209000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
            "0.232491, 0.235250, 0.239368, 0.245398, 0.256538, 0.277780, 0.319630", \
            "0.232937, 0.235696, 0.239814, 0.245844, 0.256984, 0.278226, 0.320076", \
            "0.236179, 0.238937, 0.243056, 0.249086, 0.260225, 0.281468, 0.323318", \
            "0.241468, 0.244226, 0.248345, 0.254375, 0.265514, 0.286757, 0.328607", \
            "0.249768, 0.252527, 0.256646, 0.262675, 0.273815, 0.295057, 0.336907", \
            "0.259078, 0.261836, 0.265955, 0.271984, 0.283124, 0.304367, 0.346217", \
            "0.267800, 0.270558, 0.274677, 0.280707, 0.291846, 0.313089, 0.354939" \
          );
        }
        retaining_rise(sram128x128_clockslew_outputload_retain_template) {
          index_1 ("0.001000, 0.005000, 0.018000, 0.043000, 0.082000, 0.139000, 0.209000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
