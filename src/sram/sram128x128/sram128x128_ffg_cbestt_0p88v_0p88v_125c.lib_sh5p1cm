    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }

  /* voltage-maps */
  voltage_map (VDDPE, 0.88);
  voltage_map (VDDCE, 0.88);
  voltage_map (VSSE, 0.0);

  /* operating-conditions */
  operating_conditions(ffg_cbestt_0p88v_0p88v_125c) {
    process      : 1;
    temperature  : 125;
    voltage      : 0.88;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : ffg_cbestt_0p88v_0p88v_125c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(sram128x128) {
    area : 7911.360000;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    is_macro_cell : true;
    /* Peak current of all modes. */
    peak_current : 84.849938;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 40.316596;
    /* leakage current in retention mode (ret1n=0) */
    retention_current : 0.060939;
    memory() {
      type : ram;
      address_width : 7;
      word_width : 128;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    bus(q) {
      bus_type : sram128x128_q;
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      memory_read() {
        address : a;
      }
      max_capacitance : 0.280000;
      max_transition : 0.800400;
      timing() {
        related_pin : clk;
        timing_type : rising_edge;
        timing_sense : non_unate;
        when : "ret1n&!cen&wen&!ema[2]&!ema[1]&!ema[0]";
        sdf_cond : "ret1n == 1'b1 && cen == 1'b0 && wen == 1'b1 && ema[2] == 1'b0 && \
                ema[1] == 1'b0 && ema[0] == 1'b0";
        cell_rise(sram128x128_clockslew_outputload_delay_template) {
          index_1 ("0.001000, 0.005000, 0.019000, 0.046000, 0.088000, 0.149000, 0.224000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
            "0.232693, 0.235750, 0.239725, 0.246348, 0.258326, 0.280099, 0.322818", \
            "0.233141, 0.236198, 0.240174, 0.246796, 0.258774, 0.280547, 0.323266", \
            "0.235995, 0.239052, 0.243028, 0.249651, 0.261628, 0.283402, 0.326120", \
            "0.240686, 0.243744, 0.247719, 0.254342, 0.266320, 0.288093, 0.330811", \
            "0.246821, 0.249878, 0.253854, 0.260477, 0.272455, 0.294228, 0.336946", \
            "0.254295, 0.257352, 0.261328, 0.267951, 0.279929, 0.301702, 0.344420", \
            "0.260349, 0.263406, 0.267382, 0.274005, 0.285983, 0.307756, 0.350474" \
          );
        }
        retaining_rise(sram128x128_clockslew_outputload_retain_template) {
          index_1 ("0.001000, 0.005000, 0.019000, 0.046000, 0.088000, 0.149000, 0.224000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
