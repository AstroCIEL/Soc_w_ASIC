  /* voltage-maps */
  voltage_map (VDDPE, 0.72);
  voltage_map (VDDCE, 0.72);
  voltage_map (VSSE, 0.0);

  /* operating-conditions */
  operating_conditions(ssg_cworstt_0p72v_0p72v_m40c) {
    process      : 1;
    temperature  : -40;
    voltage      : 0.72;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : ssg_cworstt_0p72v_0p72v_m40c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(sram128x128) {
    area : 7911.360000;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    is_macro_cell : true;
    /* Peak current of all modes. */
    peak_current : 35.546108;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 17.118691;
    /* leakage current in retention mode (ret1n=0) */
    retention_current : 3.676e-05;
    memory() {
      type : ram;
      address_width : 7;
      word_width : 128;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    bus(q) {
      bus_type : sram128x128_q;
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      memory_read() {
        address : a;
      }
      max_capacitance : 0.280000;
      max_transition : 1.695600;
      timing() {
        related_pin : clk;
        timing_type : rising_edge;
        timing_sense : non_unate;
        when : "ret1n&!cen&wen&!ema[2]&!ema[1]&!ema[0]";
        sdf_cond : "ret1n == 1'b1 && cen == 1'b0 && wen == 1'b1 && ema[2] == 1'b0 && \
                ema[1] == 1'b0 && ema[0] == 1'b0";
        cell_rise(sram128x128_clockslew_outputload_delay_template) {
          index_1 ("0.002000, 0.011000, 0.041000, 0.098000, 0.186000, 0.317000, 0.475000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
            "0.475220, 0.480606, 0.489787, 0.503446, 0.526382, 0.569642, 0.657971", \
            "0.477940, 0.483326, 0.492507, 0.506166, 0.529102, 0.572362, 0.660690", \
            "0.488909, 0.494295, 0.503477, 0.517136, 0.540072, 0.583337, 0.671659", \
            "0.508455, 0.513841, 0.523022, 0.536681, 0.559617, 0.602876, 0.691209", \
            "0.545096, 0.550482, 0.559663, 0.573322, 0.596255, 0.639515, 0.727848", \
            "0.590110, 0.595493, 0.604681, 0.618339, 0.641277, 0.684537, 0.772859", \
            "0.638594, 0.643981, 0.653158, 0.666816, 0.689754, 0.733014, 0.821347" \
          );
        }
        retaining_rise(sram128x128_clockslew_outputload_retain_template) {
          index_1 ("0.002000, 0.011000, 0.041000, 0.098000, 0.186000, 0.317000, 0.475000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
