  /* voltage-maps */
  voltage_map (VDDPE, 0.72);
  voltage_map (VDDCE, 0.72);
  voltage_map (VSSE, 0.0);

  /* operating-conditions */
  operating_conditions(ssg_cworstt_0p72v_0p72v_0c) {
    process      : 1;
    temperature  : 0;
    voltage      : 0.72;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : ssg_cworstt_0p72v_0p72v_0c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(sram128x128) {
    area : 7911.360000;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    is_macro_cell : true;
    /* Peak current of all modes. */
    peak_current : 37.207232;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 17.870932;
    /* leakage current in retention mode (ret1n=0) */
    retention_current : 0.0001336;
    memory() {
      type : ram;
      address_width : 7;
      word_width : 128;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    bus(q) {
      bus_type : sram128x128_q;
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      memory_read() {
        address : a;
      }
      max_capacitance : 0.280000;
      max_transition : 1.578000;
      timing() {
        related_pin : clk;
        timing_type : rising_edge;
        timing_sense : non_unate;
        when : "ret1n&!cen&wen&!ema[2]&!ema[1]&!ema[0]";
        sdf_cond : "ret1n == 1'b1 && cen == 1'b0 && wen == 1'b1 && ema[2] == 1'b0 && \
                ema[1] == 1'b0 && ema[0] == 1'b0";
        cell_rise(sram128x128_clockslew_outputload_delay_template) {
          index_1 ("0.002000, 0.011000, 0.038000, 0.091000, 0.173000, 0.294000, 0.441000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
            "0.442750, 0.447964, 0.457352, 0.470172, 0.492646, 0.532605, 0.614099", \
            "0.445156, 0.450370, 0.459758, 0.472578, 0.495052, 0.535011, 0.616505", \
            "0.454312, 0.459525, 0.468914, 0.481733, 0.504208, 0.544167, 0.625660", \
            "0.471981, 0.477195, 0.486584, 0.499403, 0.521878, 0.561836, 0.643330", \
            "0.500202, 0.505415, 0.514804, 0.527623, 0.550098, 0.590057, 0.671550", \
            "0.535707, 0.540921, 0.550310, 0.563129, 0.585604, 0.625563, 0.707052", \
            "0.572888, 0.578101, 0.587490, 0.600309, 0.622784, 0.662743, 0.744231" \
          );
        }
        retaining_rise(sram128x128_clockslew_outputload_retain_template) {
          index_1 ("0.002000, 0.011000, 0.038000, 0.091000, 0.173000, 0.294000, 0.441000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
