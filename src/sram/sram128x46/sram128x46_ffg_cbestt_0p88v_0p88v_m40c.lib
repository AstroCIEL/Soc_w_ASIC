  type (sram128x46_q) {
    base_type : array ;
    data_type : bit ;
    bit_width : 46;
    bit_from : 45;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x46_a) {
    base_type : array ;
    data_type : bit ;
    bit_width : 7;
    bit_from : 6;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x46_d) {
    base_type : array ;
    data_type : bit ;
    bit_width : 46;
    bit_from : 45;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x46_ema) {
    base_type : array ;
    data_type : bit ;
    bit_width : 3;
    bit_from : 2;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x46_emaw) {
    base_type : array ;
    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x46_wablm) {
    base_type : array ;
    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x46_rawlm) {
    base_type : array ;
    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }

  /* voltage-maps */
  voltage_map (VDDPE, 0.88);
  voltage_map (VDDCE, 0.88);
  voltage_map (VSSE, 0.0);

  /* operating-conditions */
  operating_conditions(ffg_cbestt_0p88v_0p88v_m40c) {
    process      : 1;
    temperature  : -40;
    voltage      : 0.88;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : ffg_cbestt_0p88v_0p88v_m40c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(sram128x46) {
    area : 3440.064000;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    is_macro_cell : true;
    /* Peak current of all modes. */
    peak_current : 33.160979;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 17.007575;
    /* leakage current in retention mode (ret1n=0) */
    retention_current : 0.0001396;
    memory() {
      type : ram;
      address_width : 7;
      word_width : 46;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    bus(q) {
      bus_type : sram128x46_q;
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      memory_read() {
        address : a;
      }
      max_capacitance : 0.280000;
      max_transition : 0.748800;
      timing() {
        related_pin : clk;
        timing_type : rising_edge;
        timing_sense : non_unate;
        when : "ret1n&!cen&wen&!ema[2]&!ema[1]&!ema[0]";
        sdf_cond : "ret1n == 1'b1 && cen == 1'b0 && wen == 1'b1 && ema[2] == 1'b0 && \
                ema[1] == 1'b0 && ema[0] == 1'b0";
        cell_rise(sram128x46_clockslew_outputload_delay_template) {
          index_1 ("0.001000, 0.005000, 0.018000, 0.043000, 0.082000, 0.139000, 0.209000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
            "0.193784, 0.196542, 0.200661, 0.206691, 0.217830, 0.239073, 0.280923", \
            "0.194230, 0.196988, 0.201107, 0.207137, 0.218276, 0.239519, 0.281369", \
            "0.197471, 0.200230, 0.204349, 0.210378, 0.221518, 0.242760, 0.284610", \
            "0.202760, 0.205519, 0.209638, 0.215667, 0.226807, 0.248049, 0.289899", \
            "0.211061, 0.213819, 0.217938, 0.223968, 0.235107, 0.256350, 0.298200", \
            "0.220370, 0.223129, 0.227248, 0.233277, 0.244417, 0.265659, 0.307509", \
            "0.229093, 0.231851, 0.235970, 0.242000, 0.253139, 0.274382, 0.316232" \
          );
        }
        retaining_rise(sram128x46_clockslew_outputload_retain_template) {
          index_1 ("0.001000, 0.005000, 0.018000, 0.043000, 0.082000, 0.139000, 0.209000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
