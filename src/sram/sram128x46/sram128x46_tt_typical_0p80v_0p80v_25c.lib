  type (sram128x46_q) {
    base_type : array ;
    data_type : bit ;
    bit_width : 46;
    bit_from : 45;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x46_a) {
    base_type : array ;
    data_type : bit ;
    bit_width : 7;
    bit_from : 6;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x46_d) {
    base_type : array ;
    data_type : bit ;
    bit_width : 46;
    bit_from : 45;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x46_ema) {
    base_type : array ;
    data_type : bit ;
    bit_width : 3;
    bit_from : 2;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x46_emaw) {
    base_type : array ;
    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x46_wablm) {
    base_type : array ;
    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x46_rawlm) {
    base_type : array ;
    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }

  /* voltage-maps */
  voltage_map (VDDPE, 0.8);
  voltage_map (VDDCE, 0.8);
  voltage_map (VSSE, 0.0);

  /* operating-conditions */
  operating_conditions(tt_typical_0p80v_0p80v_25c) {
    process      : 1;
    temperature  : 25;
    voltage      : 0.8;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : tt_typical_0p80v_0p80v_25c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(sram128x46) {
    area : 3440.064000;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    is_macro_cell : true;
    /* Peak current of all modes. */
    peak_current : 23.059794;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 11.826225;
    /* leakage current in retention mode (ret1n=0) */
    retention_current : 0.0003815;
    memory() {
      type : ram;
      address_width : 7;
      word_width : 46;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    bus(q) {
      bus_type : sram128x46_q;
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      memory_read() {
        address : a;
      }
      max_capacitance : 0.280000;
      max_transition : 1.042800;
      timing() {
        related_pin : clk;
        timing_type : rising_edge;
        timing_sense : non_unate;
        when : "ret1n&!cen&wen&!ema[2]&!ema[1]&!ema[0]";
        sdf_cond : "ret1n == 1'b1 && cen == 1'b0 && wen == 1'b1 && ema[2] == 1'b0 && \
                ema[1] == 1'b0 && ema[0] == 1'b0";
        cell_rise(sram128x46_clockslew_outputload_delay_template) {
          index_1 ("0.001000, 0.007000, 0.025000, 0.061000, 0.115000, 0.195000, 0.292000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
            "0.249796, 0.253170, 0.258786, 0.267644, 0.281927, 0.309540, 0.363555", \
            "0.250606, 0.253979, 0.259596, 0.268454, 0.282737, 0.310350, 0.364364", \
            "0.255464, 0.258838, 0.264454, 0.273312, 0.287595, 0.315209, 0.369223", \
            "0.263565, 0.266939, 0.272555, 0.281413, 0.295696, 0.323309, 0.377324", \
            "0.276403, 0.279776, 0.285392, 0.294250, 0.308533, 0.336147, 0.390161", \
            "0.291010, 0.294384, 0.300000, 0.308858, 0.323141, 0.350755, 0.404769", \
            "0.303535, 0.306909, 0.312525, 0.321383, 0.335666, 0.363279, 0.417294" \
          );
        }
        retaining_rise(sram128x46_clockslew_outputload_retain_template) {
          index_1 ("0.001000, 0.007000, 0.025000, 0.061000, 0.115000, 0.195000, 0.292000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
