  type (sram128x46_q) {
    base_type : array ;
    data_type : bit ;
    bit_width : 46;
    bit_from : 45;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x46_a) {
    base_type : array ;
    data_type : bit ;
    bit_width : 7;
    bit_from : 6;
    bit_to : 0 ;
    downto : true ;
  }
