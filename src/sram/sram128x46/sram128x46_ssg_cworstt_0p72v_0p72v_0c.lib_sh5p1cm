  /* voltage-maps */
  voltage_map (VDDPE, 0.72);
  voltage_map (VDDCE, 0.72);
  voltage_map (VSSE, 0.0);

  /* operating-conditions */
  operating_conditions(ssg_cworstt_0p72v_0p72v_0c) {
    process      : 1;
    temperature  : 0;
    voltage      : 0.72;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : ssg_cworstt_0p72v_0p72v_0c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(sram128x46) {
    area : 3440.064000;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    is_macro_cell : true;
    /* Peak current of all modes. */
    peak_current : 14.250449;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 7.305337;
    /* leakage current in retention mode (ret1n=0) */
    retention_current : 6.441e-05;
    memory() {
      type : ram;
      address_width : 7;
      word_width : 46;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    bus(q) {
      bus_type : sram128x46_q;
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      memory_read() {
        address : a;
      }
      max_capacitance : 0.280000;
      max_transition : 1.578000;
      timing() {
        related_pin : clk;
        timing_type : rising_edge;
        timing_sense : non_unate;
        when : "ret1n&!cen&wen&!ema[2]&!ema[1]&!ema[0]";
        sdf_cond : "ret1n == 1'b1 && cen == 1'b0 && wen == 1'b1 && ema[2] == 1'b0 && \
                ema[1] == 1'b0 && ema[0] == 1'b0";
        cell_rise(sram128x46_clockslew_outputload_delay_template) {
          index_1 ("0.002000, 0.011000, 0.038000, 0.091000, 0.173000, 0.294000, 0.441000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
            "0.384359, 0.389573, 0.398961, 0.411781, 0.434255, 0.474214, 0.555708", \
            "0.386765, 0.391979, 0.401367, 0.414187, 0.436661, 0.476620, 0.558114", \
            "0.395921, 0.401135, 0.410523, 0.423343, 0.445817, 0.485776, 0.567270", \
            "0.413590, 0.418804, 0.428193, 0.441012, 0.463487, 0.503446, 0.584939", \
            "0.441811, 0.447025, 0.456413, 0.469233, 0.491707, 0.531666, 0.613160", \
            "0.477317, 0.482531, 0.491919, 0.504738, 0.527213, 0.567172, 0.648661", \
            "0.514497, 0.519711, 0.529099, 0.541919, 0.564393, 0.604352, 0.685840" \
          );
        }
        retaining_rise(sram128x46_clockslew_outputload_retain_template) {
          index_1 ("0.002000, 0.011000, 0.038000, 0.091000, 0.173000, 0.294000, 0.441000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
