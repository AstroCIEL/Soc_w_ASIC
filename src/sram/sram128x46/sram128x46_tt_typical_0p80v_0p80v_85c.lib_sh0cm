  type (sram128x46_q) {
    base_type : array ;
    data_type : bit ;
    bit_width : 46;
    bit_from : 45;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x46_a) {
    base_type : array ;
    data_type : bit ;
    bit_width : 7;
    bit_from : 6;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x46_d) {
    base_type : array ;
    data_type : bit ;
    bit_width : 46;
    bit_from : 45;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x46_ema) {
    base_type : array ;
    data_type : bit ;
    bit_width : 3;
    bit_from : 2;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x46_emaw) {
    base_type : array ;
    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x46_wablm) {
    base_type : array ;
    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram128x46_rawlm) {
    base_type : array ;
    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }

  /* voltage-maps */
  voltage_map (VDDPE, 0.8);
  voltage_map (VDDCE, 0.8);
  voltage_map (VSSE, 0.0);

  /* operating-conditions */
  operating_conditions(tt_typical_0p80v_0p80v_85c) {
    process      : 1;
    temperature  : 85;
    voltage      : 0.8;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : tt_typical_0p80v_0p80v_85c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(sram128x46) {
    area : 3440.064000;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    is_macro_cell : true;
    /* Peak current of all modes. */
    peak_current : 23.325237;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 11.963366;
    /* leakage current in retention mode (ret1n=0) */
    retention_current : 0.004336;
    memory() {
      type : ram;
      address_width : 7;
      word_width : 46;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    bus(q) {
      bus_type : sram128x46_q;
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      memory_read() {
        address : a;
      }
      max_capacitance : 0.280000;
      max_transition : 1.042800;
      timing() {
        related_pin : clk;
        timing_type : rising_edge;
        timing_sense : non_unate;
        when : "ret1n&!cen&wen&!ema[2]&!ema[1]&!ema[0]";
        sdf_cond : "ret1n == 1'b1 && cen == 1'b0 && wen == 1'b1 && ema[2] == 1'b0 && \
                ema[1] == 1'b0 && ema[0] == 1'b0";
        cell_rise(sram128x46_clockslew_outputload_delay_template) {
          index_1 ("0.001000, 0.007000, 0.025000, 0.061000, 0.115000, 0.195000, 0.292000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
            "0.241691, 0.245552, 0.251645, 0.259761, 0.274014, 0.301765, 0.354465", \
            "0.242923, 0.246784, 0.252877, 0.260993, 0.275246, 0.302997, 0.355697", \
            "0.247177, 0.251038, 0.257131, 0.265247, 0.279500, 0.307250, 0.359950", \
            "0.254205, 0.258067, 0.264159, 0.272276, 0.286529, 0.314279, 0.366979", \
            "0.264932, 0.268793, 0.274886, 0.283002, 0.297255, 0.325006, 0.377706", \
            "0.277117, 0.280978, 0.287071, 0.295187, 0.309440, 0.337190, 0.389890", \
            "0.287051, 0.290912, 0.297005, 0.305121, 0.319374, 0.347125, 0.399824" \
          );
        }
        retaining_rise(sram128x46_clockslew_outputload_retain_template) {
          index_1 ("0.001000, 0.007000, 0.025000, 0.061000, 0.115000, 0.195000, 0.292000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
