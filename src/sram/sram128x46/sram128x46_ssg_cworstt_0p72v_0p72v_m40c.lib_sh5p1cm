  /* voltage-maps */
  voltage_map (VDDPE, 0.72);
  voltage_map (VDDCE, 0.72);
  voltage_map (VSSE, 0.0);

  /* operating-conditions */
  operating_conditions(ssg_cworstt_0p72v_0p72v_m40c) {
    process      : 1;
    temperature  : -40;
    voltage      : 0.72;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : ssg_cworstt_0p72v_0p72v_m40c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(sram128x46) {
    area : 3440.064000;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    is_macro_cell : true;
    /* Peak current of all modes. */
    peak_current : 13.577676;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 6.959413;
    /* leakage current in retention mode (ret1n=0) */
    retention_current : 1.77e-05;
    memory() {
      type : ram;
      address_width : 7;
      word_width : 46;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    bus(q) {
      bus_type : sram128x46_q;
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      memory_read() {
        address : a;
      }
      max_capacitance : 0.280000;
      max_transition : 1.695600;
      timing() {
        related_pin : clk;
        timing_type : rising_edge;
        timing_sense : non_unate;
        when : "ret1n&!cen&wen&!ema[2]&!ema[1]&!ema[0]";
        sdf_cond : "ret1n == 1'b1 && cen == 1'b0 && wen == 1'b1 && ema[2] == 1'b0 && \
                ema[1] == 1'b0 && ema[0] == 1'b0";
        cell_rise(sram128x46_clockslew_outputload_delay_template) {
          index_1 ("0.002000, 0.011000, 0.041000, 0.098000, 0.186000, 0.317000, 0.475000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
            "0.412606, 0.417992, 0.427174, 0.440832, 0.463769, 0.507029, 0.595357", \
            "0.415327, 0.420712, 0.429894, 0.443553, 0.466489, 0.509749, 0.598076", \
            "0.426296, 0.431682, 0.440863, 0.454522, 0.477458, 0.520723, 0.609046", \
            "0.445841, 0.451227, 0.460409, 0.474067, 0.497004, 0.540263, 0.628595", \
            "0.482482, 0.487868, 0.497050, 0.510708, 0.533641, 0.576901, 0.665234", \
            "0.527497, 0.532880, 0.542067, 0.555725, 0.578663, 0.621923, 0.710246", \
            "0.575981, 0.581368, 0.590545, 0.604203, 0.627141, 0.670401, 0.758734" \
          );
        }
        retaining_rise(sram128x46_clockslew_outputload_retain_template) {
          index_1 ("0.002000, 0.011000, 0.041000, 0.098000, 0.186000, 0.317000, 0.475000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
