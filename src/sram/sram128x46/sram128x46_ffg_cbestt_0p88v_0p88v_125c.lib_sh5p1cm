    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }

  /* voltage-maps */
  voltage_map (VDDPE, 0.88);
  voltage_map (VDDCE, 0.88);
  voltage_map (VSSE, 0.0);

  /* operating-conditions */
  operating_conditions(ffg_cbestt_0p88v_0p88v_125c) {
    process      : 1;
    temperature  : 125;
    voltage      : 0.88;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : ffg_cbestt_0p88v_0p88v_125c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(sram128x46) {
    area : 3440.064000;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    is_macro_cell : true;
    /* Peak current of all modes. */
    peak_current : 32.848390;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 16.849282;
    /* leakage current in retention mode (ret1n=0) */
    retention_current : 0.029686;
    memory() {
      type : ram;
      address_width : 7;
      word_width : 46;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    bus(q) {
      bus_type : sram128x46_q;
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      memory_read() {
        address : a;
      }
      max_capacitance : 0.280000;
      max_transition : 0.800400;
      timing() {
        related_pin : clk;
        timing_type : rising_edge;
        timing_sense : non_unate;
        when : "ret1n&!cen&wen&!ema[2]&!ema[1]&!ema[0]";
        sdf_cond : "ret1n == 1'b1 && cen == 1'b0 && wen == 1'b1 && ema[2] == 1'b0 && \
                ema[1] == 1'b0 && ema[0] == 1'b0";
        cell_rise(sram128x46_clockslew_outputload_delay_template) {
          index_1 ("0.001000, 0.005000, 0.019000, 0.046000, 0.088000, 0.149000, 0.224000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
            "0.190436, 0.193493, 0.197468, 0.204091, 0.216069, 0.237842, 0.280561", \
            "0.190884, 0.193941, 0.197916, 0.204539, 0.216517, 0.238290, 0.281009", \
            "0.193738, 0.196795, 0.200771, 0.207393, 0.219371, 0.241145, 0.283863", \
            "0.198429, 0.201486, 0.205462, 0.212085, 0.224063, 0.245836, 0.288554", \
            "0.204564, 0.207621, 0.211597, 0.218220, 0.230198, 0.251971, 0.294689", \
            "0.212038, 0.215095, 0.219071, 0.225694, 0.237672, 0.259445, 0.302163", \
            "0.218092, 0.221149, 0.225125, 0.231748, 0.243726, 0.265499, 0.308217" \
          );
        }
        retaining_rise(sram128x46_clockslew_outputload_retain_template) {
          index_1 ("0.001000, 0.005000, 0.019000, 0.046000, 0.088000, 0.149000, 0.224000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
