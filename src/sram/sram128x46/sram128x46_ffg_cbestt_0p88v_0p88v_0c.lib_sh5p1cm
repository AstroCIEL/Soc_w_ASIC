  /* voltage-maps */
  voltage_map (VDDPE, 0.88);
  voltage_map (VDDCE, 0.88);
  voltage_map (VSSE, 0.0);

  /* operating-conditions */
  operating_conditions(ffg_cbestt_0p88v_0p88v_0c) {
    process      : 1;
    temperature  : 0;
    voltage      : 0.88;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : ffg_cbestt_0p88v_0p88v_0c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(sram128x46) {
    area : 3440.064000;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    is_macro_cell : true;
    /* Peak current of all modes. */
    peak_current : 32.761945;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 16.804251;
    /* leakage current in retention mode (ret1n=0) */
    retention_current : 0.0004593;
    memory() {
      type : ram;
      address_width : 7;
      word_width : 46;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    bus(q) {
      bus_type : sram128x46_q;
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      memory_read() {
        address : a;
      }
      max_capacitance : 0.280000;
      max_transition : 0.758400;
      timing() {
        related_pin : clk;
        timing_type : rising_edge;
        timing_sense : non_unate;
        when : "ret1n&!cen&wen&!ema[2]&!ema[1]&!ema[0]";
        sdf_cond : "ret1n == 1'b1 && cen == 1'b0 && wen == 1'b1 && ema[2] == 1'b0 && \
                ema[1] == 1'b0 && ema[0] == 1'b0";
        cell_rise(sram128x46_clockslew_outputload_delay_template) {
          index_1 ("0.001000, 0.005000, 0.018000, 0.044000, 0.083000, 0.141000, 0.212000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
            "0.193145, 0.195984, 0.200063, 0.206321, 0.217585, 0.238958, 0.280933", \
            "0.193467, 0.196305, 0.200384, 0.206643, 0.217907, 0.239279, 0.281255", \
            "0.196358, 0.199197, 0.203275, 0.209534, 0.220798, 0.242170, 0.284146", \
            "0.201427, 0.204265, 0.208344, 0.214602, 0.225866, 0.247239, 0.289215", \
            "0.208764, 0.211602, 0.215681, 0.221939, 0.233203, 0.254576, 0.296551", \
            "0.217035, 0.219874, 0.223953, 0.230211, 0.241475, 0.262848, 0.304823", \
            "0.224499, 0.227337, 0.231416, 0.237674, 0.248938, 0.270311, 0.312287" \
          );
        }
        retaining_rise(sram128x46_clockslew_outputload_retain_template) {
          index_1 ("0.001000, 0.005000, 0.018000, 0.044000, 0.083000, 0.141000, 0.212000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
