  /* voltage-maps */
  voltage_map (VDDPE, 0.72);
  voltage_map (VDDCE, 0.72);
  voltage_map (VSSE, 0.0);

  /* operating-conditions */
  operating_conditions(ssg_cworstt_0p72v_0p72v_125c) {
    process      : 1;
    temperature  : 125;
    voltage      : 0.72;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : ssg_cworstt_0p72v_0p72v_125c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(sram128x46) {
    area : 3440.064000;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    is_macro_cell : true;
    /* Peak current of all modes. */
    peak_current : 15.725662;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 8.064731;
    /* leakage current in retention mode (ret1n=0) */
    retention_current : 0.006398;
    memory() {
      type : ram;
      address_width : 7;
      word_width : 46;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    bus(q) {
      bus_type : sram128x46_q;
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      memory_read() {
        address : a;
      }
      max_capacitance : 0.280000;
      max_transition : 1.419600;
      timing() {
        related_pin : clk;
        timing_type : rising_edge;
        timing_sense : non_unate;
        when : "ret1n&!cen&wen&!ema[2]&!ema[1]&!ema[0]";
        sdf_cond : "ret1n == 1'b1 && cen == 1'b0 && wen == 1'b1 && ema[2] == 1'b0 && \
                ema[1] == 1'b0 && ema[0] == 1'b0";
        cell_rise(sram128x46_clockslew_outputload_delay_template) {
          index_1 ("0.002000, 0.009000, 0.034000, 0.082000, 0.155000, 0.264000, 0.396000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
            "0.322831, 0.330512, 0.336434, 0.349578, 0.368613, 0.404164, 0.475142", \
            "0.326238, 0.333919, 0.339841, 0.352985, 0.372021, 0.407571, 0.478549", \
            "0.332473, 0.340153, 0.346076, 0.359220, 0.378255, 0.413806, 0.484784", \
            "0.343110, 0.350790, 0.356713, 0.369857, 0.388892, 0.424443, 0.495421", \
            "0.360076, 0.367757, 0.373679, 0.386823, 0.405859, 0.441409, 0.512387", \
            "0.378474, 0.386155, 0.392078, 0.405221, 0.424257, 0.459807, 0.530786", \
            "0.396099, 0.403779, 0.409702, 0.422846, 0.441881, 0.477432, 0.548410" \
          );
        }
        retaining_rise(sram128x46_clockslew_outputload_retain_template) {
          index_1 ("0.002000, 0.009000, 0.034000, 0.082000, 0.155000, 0.264000, 0.396000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
