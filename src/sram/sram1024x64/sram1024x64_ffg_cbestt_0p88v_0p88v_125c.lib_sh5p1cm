    bit_to : 0 ;
    downto : true ;
  }

  /* voltage-maps */
  voltage_map (VDDPE, 0.88);
  voltage_map (VDDCE, 0.88);
  voltage_map (VSSE, 0.0);

  /* operating-conditions */
  operating_conditions(ffg_cbestt_0p88v_0p88v_125c) {
    process      : 1;
    temperature  : 125;
    voltage      : 0.88;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : ffg_cbestt_0p88v_0p88v_125c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(sram1024x64) {
    area : 25080.686250;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    is_macro_cell : true;
    /* Peak current of all modes. */
    peak_current : 104.334791;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 53.075139;
    /* leakage current in retention mode (RET1N=0) */
    retention_current : 0.203093;
    memory() {
      type : ram;
      address_width : 10;
      word_width : 64;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    bus(Q) {
      bus_type : sram1024x64_Q;
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      memory_read() {
        address : A;
      }
      max_capacitance : 0.280000;
      max_transition : 0.800400;
      timing() {
        related_pin : CLK;
        timing_type : rising_edge;
        timing_sense : non_unate;
        when : "!CEN&RET1N&GWEN&!EMA[2]&!EMA[1]&!EMA[0]";
        sdf_cond : "CEN == 1'b0 && RET1N == 1'b1 && GWEN == 1'b1 && EMA[2] == 1'b0 && \
                EMA[1] == 1'b0 && EMA[0] == 1'b0";
        cell_rise(sram1024x64_clockslew_outputload_delay_template) {
          index_1 ("0.001000, 0.005000, 0.019000, 0.046000, 0.088000, 0.149000, 0.224000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
            "0.373296, 0.377641, 0.384587, 0.395567, 0.415493, 0.453635, 0.529858", \
            "0.373600, 0.377945, 0.384891, 0.395871, 0.415797, 0.453939, 0.530162", \
            "0.375845, 0.380190, 0.387136, 0.398116, 0.418042, 0.456184, 0.532407", \
            "0.378426, 0.382771, 0.389717, 0.400697, 0.420623, 0.458765, 0.534988", \
            "0.380068, 0.384413, 0.391359, 0.402339, 0.422265, 0.460407, 0.536630", \
            "0.380891, 0.385236, 0.392182, 0.403162, 0.423088, 0.461230, 0.537453", \
            "0.381113, 0.385458, 0.392404, 0.403384, 0.423310, 0.461452, 0.537675" \
          );
