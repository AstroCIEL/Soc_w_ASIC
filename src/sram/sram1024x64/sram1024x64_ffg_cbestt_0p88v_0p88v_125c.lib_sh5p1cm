  type (sram1024x64_Q) {
    base_type : array ;
    data_type : bit ;
    bit_width : 64;
    bit_from : 63;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_A) {
    base_type : array ;
    data_type : bit ;
    bit_width : 10;
    bit_from : 9;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_D) {
    base_type : array ;
    data_type : bit ;
    bit_width : 64;
    bit_from : 63;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_WEN) {
    base_type : array ;
    data_type : bit ;
    bit_width : 64;
    bit_from : 63;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_EMA) {
    base_type : array ;
    data_type : bit ;
    bit_width : 3;
    bit_from : 2;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_EMAW) {
