  type (sram1024x64_Q) {
    base_type : array ;
    data_type : bit ;
    bit_width : 64;
    bit_from : 63;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_A) {
    base_type : array ;
    data_type : bit ;
    bit_width : 10;
    bit_from : 9;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_D) {
    base_type : array ;
    data_type : bit ;
    bit_width : 64;
    bit_from : 63;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_WEN) {
    base_type : array ;
    data_type : bit ;
    bit_width : 64;
    bit_from : 63;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_EMA) {
    base_type : array ;
    data_type : bit ;
    bit_width : 3;
    bit_from : 2;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_EMAW) {
    base_type : array ;
    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_WABLM) {
    base_type : array ;
    data_type : bit ;
    bit_width : 3;
    bit_from : 2;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_RAWLM) {
    base_type : array ;
    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }

  /* voltage-maps */
  voltage_map (VDDPE, 0.8);
  voltage_map (VDDCE, 0.8);
  voltage_map (VSSE, 0.0);

  /* operating-conditions */
  operating_conditions(tt_typical_0p80v_0p80v_85c) {
    process      : 1;
    temperature  : 85;
    voltage      : 0.8;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : tt_typical_0p80v_0p80v_85c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(sram1024x64) {
    area : 25080.686250;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    is_macro_cell : true;
    /* Peak current of all modes. */
    peak_current : 65.571518;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 33.356250;
    /* leakage current in retention mode (RET1N=0) */
    retention_current : 0.027978;
    memory() {
      type : ram;
      address_width : 10;
      word_width : 64;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    bus(Q) {
      bus_type : sram1024x64_Q;
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      memory_read() {
        address : A;
      }
      max_capacitance : 0.280000;
      max_transition : 1.042800;
      timing() {
        related_pin : CLK;
        timing_type : rising_edge;
        timing_sense : non_unate;
        when : "!CEN&RET1N&GWEN&!EMA[2]&!EMA[1]&!EMA[0]";
        sdf_cond : "CEN == 1'b0 && RET1N == 1'b1 && GWEN == 1'b1 && EMA[2] == 1'b0 && \
                EMA[1] == 1'b0 && EMA[0] == 1'b0";
        cell_rise(sram1024x64_clockslew_outputload_delay_template) {
          index_1 ("0.001000, 0.007000, 0.025000, 0.061000, 0.115000, 0.195000, 0.292000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
            "0.500291, 0.507252, 0.515657, 0.529941, 0.555387, 0.602733, 0.697423", \
            "0.502096, 0.509057, 0.517462, 0.531746, 0.557192, 0.604538, 0.699228", \
            "0.505345, 0.512306, 0.520711, 0.534995, 0.560441, 0.607787, 0.702477", \
            "0.511013, 0.517974, 0.526379, 0.540663, 0.566109, 0.613455, 0.708145", \
            "0.514658, 0.521619, 0.530024, 0.544308, 0.569754, 0.617100, 0.711790", \
            "0.517661, 0.524622, 0.533027, 0.547311, 0.572757, 0.620103, 0.714793", \
            "0.518780, 0.525741, 0.534146, 0.548430, 0.573876, 0.621222, 0.715912" \
          );
        }
