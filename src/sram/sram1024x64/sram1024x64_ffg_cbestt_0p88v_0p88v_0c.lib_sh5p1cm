  type (sram1024x64_Q) {
    base_type : array ;
    data_type : bit ;
    bit_width : 64;
    bit_from : 63;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_A) {
    base_type : array ;
    data_type : bit ;
    bit_width : 10;
    bit_from : 9;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_D) {
    base_type : array ;
    data_type : bit ;
    bit_width : 64;
    bit_from : 63;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_WEN) {
    base_type : array ;
    data_type : bit ;
    bit_width : 64;
    bit_from : 63;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_EMA) {
    base_type : array ;
    data_type : bit ;
    bit_width : 3;
    bit_from : 2;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_EMAW) {
    base_type : array ;
    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_WABLM) {
    base_type : array ;
    data_type : bit ;
    bit_width : 3;
    bit_from : 2;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_RAWLM) {
    base_type : array ;
    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }

  /* voltage-maps */
  voltage_map (VDDPE, 0.88);
  voltage_map (VDDCE, 0.88);
  voltage_map (VSSE, 0.0);

  /* operating-conditions */
  operating_conditions(ffg_cbestt_0p88v_0p88v_0c) {
    process      : 1;
    temperature  : 0;
    voltage      : 0.88;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : ffg_cbestt_0p88v_0p88v_0c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(sram1024x64) {
    area : 25080.686250;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    is_macro_cell : true;
    /* Peak current of all modes. */
    peak_current : 86.221112;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 43.860705;
    /* leakage current in retention mode (RET1N=0) */
    retention_current : 0.003422;
    memory() {
      type : ram;
      address_width : 10;
      word_width : 64;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    bus(Q) {
      bus_type : sram1024x64_Q;
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      memory_read() {
        address : A;
      }
      max_capacitance : 0.280000;
      max_transition : 0.758400;
      timing() {
        related_pin : CLK;
        timing_type : rising_edge;
        timing_sense : non_unate;
        when : "!CEN&RET1N&GWEN&!EMA[2]&!EMA[1]&!EMA[0]";
        sdf_cond : "CEN == 1'b0 && RET1N == 1'b1 && GWEN == 1'b1 && EMA[2] == 1'b0 && \
                EMA[1] == 1'b0 && EMA[0] == 1'b0";
        cell_rise(sram1024x64_clockslew_outputload_delay_template) {
          index_1 ("0.001000, 0.005000, 0.018000, 0.044000, 0.083000, 0.141000, 0.212000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
            "0.383534, 0.387616, 0.394388, 0.405152, 0.424879, 0.462715, 0.536958", \
            "0.383592, 0.387674, 0.394446, 0.405210, 0.424937, 0.462773, 0.537016", \
            "0.386716, 0.390798, 0.397570, 0.408334, 0.428061, 0.465897, 0.540140", \
            "0.389641, 0.393723, 0.400495, 0.411259, 0.430986, 0.468822, 0.543065", \
            "0.392017, 0.396099, 0.402871, 0.413635, 0.433362, 0.471198, 0.545441", \
            "0.394090, 0.398172, 0.404944, 0.415708, 0.435435, 0.473271, 0.547514", \
            "0.394767, 0.398849, 0.405621, 0.416385, 0.436112, 0.473948, 0.548191" \
          );
