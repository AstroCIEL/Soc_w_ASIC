  type (sram1024x64_Q) {
    base_type : array ;
    data_type : bit ;
    bit_width : 64;
    bit_from : 63;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_A) {
    base_type : array ;
    data_type : bit ;
    bit_width : 10;
    bit_from : 9;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_D) {
    base_type : array ;
    data_type : bit ;
    bit_width : 64;
    bit_from : 63;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_WEN) {
    base_type : array ;
    data_type : bit ;
    bit_width : 64;
    bit_from : 63;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_EMA) {
    base_type : array ;
    data_type : bit ;
    bit_width : 3;
    bit_from : 2;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_EMAW) {
    base_type : array ;
    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_WABLM) {
    base_type : array ;
    data_type : bit ;
    bit_width : 3;
    bit_from : 2;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_RAWLM) {
    base_type : array ;
    data_type : bit ;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0 ;
    downto : true ;
  }

  /* voltage-maps */
  voltage_map (VDDPE, 0.8);
  voltage_map (VDDCE, 0.8);
  voltage_map (VSSE, 0.0);

  /* operating-conditions */
  operating_conditions(tt_typical_0p80v_0p80v_25c) {
    process      : 1;
    temperature  : 25;
    voltage      : 0.8;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : tt_typical_0p80v_0p80v_25c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(sram1024x64) {
    area : 25080.686250;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    is_macro_cell : true;
    /* Peak current of all modes. */
    peak_current : 61.948782;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 31.513364;
    /* leakage current in retention mode (RET1N=0) */
    retention_current : 0.002785;
    memory() {
      type : ram;
      address_width : 10;
      word_width : 64;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    bus(Q) {
      bus_type : sram1024x64_Q;
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      memory_read() {
        address : A;
      }
      max_capacitance : 0.280000;
      max_transition : 1.042800;
      timing() {
        related_pin : CLK;
        timing_type : rising_edge;
        timing_sense : non_unate;
        when : "!CEN&RET1N&GWEN&!EMA[2]&!EMA[1]&!EMA[0]";
        sdf_cond : "CEN == 1'b0 && RET1N == 1'b1 && GWEN == 1'b1 && EMA[2] == 1'b0 && \
                EMA[1] == 1'b0 && EMA[0] == 1'b0";
        cell_rise(sram1024x64_clockslew_outputload_delay_template) {
          index_1 ("0.001000, 0.007000, 0.025000, 0.061000, 0.115000, 0.195000, 0.292000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
            "0.531931, 0.538283, 0.546599, 0.560489, 0.586639, 0.634468, 0.730765", \
            "0.533061, 0.539413, 0.547729, 0.561619, 0.587769, 0.635598, 0.731895", \
            "0.537419, 0.543771, 0.552087, 0.565977, 0.592127, 0.639956, 0.736253", \
            "0.543785, 0.550137, 0.558453, 0.572343, 0.598493, 0.646322, 0.742619", \
            "0.549477, 0.555829, 0.564145, 0.578035, 0.604185, 0.652014, 0.748311", \
            "0.554317, 0.560669, 0.568985, 0.582875, 0.609025, 0.656854, 0.753151", \
            "0.557921, 0.564273, 0.572589, 0.586479, 0.612629, 0.660458, 0.756755" \
          );
        }
