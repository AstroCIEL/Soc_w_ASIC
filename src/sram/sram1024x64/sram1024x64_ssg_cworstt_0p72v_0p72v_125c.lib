  /* voltage-maps */
  voltage_map (VDDPE, 0.72);
  voltage_map (VDDCE, 0.72);
  voltage_map (VSSE, 0.0);

  /* operating-conditions */
  operating_conditions(ssg_cworstt_0p72v_0p72v_125c) {
    process      : 1;
    temperature  : 125;
    voltage      : 0.72;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : ssg_cworstt_0p72v_0p72v_125c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(sram1024x64) {
    area : 25080.686250;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    is_macro_cell : true;
    /* Peak current of all modes. */
    peak_current : 49.269207;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 25.063260;
    /* leakage current in retention mode (RET1N=0) */
    retention_current : 0.039499;
    memory() {
      type : ram;
      address_width : 10;
      word_width : 64;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    bus(Q) {
      bus_type : sram1024x64_Q;
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      memory_read() {
        address : A;
      }
      max_capacitance : 0.280000;
      max_transition : 1.419600;
      timing() {
        related_pin : CLK;
        timing_type : rising_edge;
        timing_sense : non_unate;
        when : "!CEN&RET1N&GWEN&!EMA[2]&!EMA[1]&!EMA[0]";
        sdf_cond : "CEN == 1'b0 && RET1N == 1'b1 && GWEN == 1'b1 && EMA[2] == 1'b0 && \
                EMA[1] == 1'b0 && EMA[0] == 1'b0";
        cell_rise(sram1024x64_clockslew_outputload_delay_template) {
          index_1 ("0.002000, 0.009000, 0.034000, 0.082000, 0.155000, 0.264000, 0.396000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
            "0.697470, 0.706959, 0.718013, 0.736792, 0.769752, 0.832402, 0.955062", \
            "0.699581, 0.709070, 0.720124, 0.738902, 0.771862, 0.834512, 0.957172", \
            "0.705529, 0.715018, 0.726072, 0.744852, 0.777812, 0.840462, 0.963122", \
            "0.714214, 0.723702, 0.734752, 0.753532, 0.786492, 0.849142, 0.971802", \
            "0.720818, 0.730302, 0.741362, 0.760142, 0.793102, 0.855752, 0.978412", \
            "0.726652, 0.736142, 0.747192, 0.765972, 0.798932, 0.861582, 0.984242", \
            "0.729542, 0.739032, 0.750082, 0.768862, 0.801822, 0.864472, 0.987132" \
          );
