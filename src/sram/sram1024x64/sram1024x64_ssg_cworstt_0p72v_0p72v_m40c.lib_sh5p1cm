  /* voltage-maps */
  voltage_map (VDDPE, 0.72);
  voltage_map (VDDCE, 0.72);
  voltage_map (VSSE, 0.0);

  /* operating-conditions */
  operating_conditions(ssg_cworstt_0p72v_0p72v_m40c) {
    process      : 1;
    temperature  : -40;
    voltage      : 0.72;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : ssg_cworstt_0p72v_0p72v_m40c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(sram1024x64) {
    area : 25080.686250;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    is_macro_cell : true;
    /* Peak current of all modes. */
    peak_current : 36.227358;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 18.428868;
    /* leakage current in retention mode (RET1N=0) */
    retention_current : 0.0001409;
    memory() {
      type : ram;
      address_width : 10;
      word_width : 64;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    bus(Q) {
      bus_type : sram1024x64_Q;
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      memory_read() {
        address : A;
      }
      max_capacitance : 0.280000;
      max_transition : 1.695600;
      timing() {
        related_pin : CLK;
        timing_type : rising_edge;
        timing_sense : non_unate;
        when : "!CEN&RET1N&GWEN&!EMA[2]&!EMA[1]&!EMA[0]";
        sdf_cond : "CEN == 1'b0 && RET1N == 1'b1 && GWEN == 1'b1 && EMA[2] == 1'b0 && \
                EMA[1] == 1'b0 && EMA[0] == 1'b0";
        cell_rise(sram1024x64_clockslew_outputload_delay_template) {
          index_1 ("0.002000, 0.011000, 0.041000, 0.098000, 0.186000, 0.317000, 0.475000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
            "1.012506, 1.021956, 1.034676, 1.057136, 1.095936, 1.168436, 1.313306", \
            "1.015246, 1.024696, 1.037416, 1.059876, 1.098676, 1.171176, 1.316046", \
            "1.025946, 1.035396, 1.048116, 1.070576, 1.109376, 1.181876, 1.326746", \
            "1.044616, 1.054066, 1.066786, 1.089246, 1.128046, 1.200546, 1.345416", \
            "1.068636, 1.078086, 1.090806, 1.113266, 1.152066, 1.224566, 1.369436", \
            "1.096086, 1.105536, 1.118256, 1.140716, 1.179516, 1.252016, 1.396886", \
            "1.125056, 1.134506, 1.147226, 1.169686, 1.208486, 1.280986, 1.425856" \
          );
