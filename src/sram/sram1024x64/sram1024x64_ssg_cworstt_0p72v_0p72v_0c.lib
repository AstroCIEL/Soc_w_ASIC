  /* voltage-maps */
  voltage_map (VDDPE, 0.72);
  voltage_map (VDDCE, 0.72);
  voltage_map (VSSE, 0.0);

  /* operating-conditions */
  operating_conditions(ssg_cworstt_0p72v_0p72v_0c) {
    process      : 1;
    temperature  : 0;
    voltage      : 0.72;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : ssg_cworstt_0p72v_0p72v_0c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(sram1024x64) {
    area : 25080.686250;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    is_macro_cell : true;
    /* Peak current of all modes. */
    peak_current : 38.763273;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 19.718889;
    /* leakage current in retention mode (RET1N=0) */
    retention_current : 0.000467;
    memory() {
      type : ram;
      address_width : 10;
      word_width : 64;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
      direction : inout;
    }
    pg_pin(VSSE) {
      voltage_name : VSSE;
      pg_type : primary_ground;
      direction : inout;
    }
    bus(Q) {
      bus_type : sram1024x64_Q;
      direction : output;
      related_power_pin : "VDDPE";
      related_ground_pin : "VSSE";
      power_down_function : "!VDDCE + !VDDPE + VSSE";
      memory_read() {
        address : A;
      }
      max_capacitance : 0.280000;
      max_transition : 1.578000;
      timing() {
        related_pin : CLK;
        timing_type : rising_edge;
        timing_sense : non_unate;
        when : "!CEN&RET1N&GWEN&!EMA[2]&!EMA[1]&!EMA[0]";
        sdf_cond : "CEN == 1'b0 && RET1N == 1'b1 && GWEN == 1'b1 && EMA[2] == 1'b0 && \
                EMA[1] == 1'b0 && EMA[0] == 1'b0";
        cell_rise(sram1024x64_clockslew_outputload_delay_template) {
          index_1 ("0.002000, 0.011000, 0.038000, 0.091000, 0.173000, 0.294000, 0.441000");
          index_2 ("0.004000, 0.009000, 0.018000, 0.035000, 0.070000, 0.140000, 0.280000");
          values (\
            "0.903368, 0.909908, 0.922788, 0.945838, 0.980238, 1.053318, 1.188538", \
            "0.904398, 0.910938, 0.923818, 0.946868, 0.981268, 1.054348, 1.189568", \
            "0.913128, 0.919668, 0.932548, 0.955598, 0.989998, 1.063078, 1.198298", \
            "0.928978, 0.935518, 0.948398, 0.971448, 1.005848, 1.078928, 1.214148", \
            "0.948998, 0.955538, 0.968418, 0.991468, 1.025868, 1.098948, 1.234168", \
            "0.968028, 0.974568, 0.987448, 1.010498, 1.044898, 1.117978, 1.253198", \
            "0.985318, 0.991858, 1.004738, 1.027788, 1.062188, 1.135268, 1.270488" \
          );
