  type (sram1024x64_Q) {
    base_type : array ;
    data_type : bit ;
    bit_width : 64;
    bit_from : 63;
    bit_to : 0 ;
    downto : true ;
  }
  type (sram1024x64_A) {
    base_type : array ;
